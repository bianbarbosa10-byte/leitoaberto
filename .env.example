# Copie para ".env" (mesma pasta) e preencha. O .env NUNCA vai para o GitHub (esta no .gitignore).
# No GitHub Actions, os mesmos nomes sao cadastrados em Settings > Secrets and variables > Actions.

# Cloudflare R2 (data lake: bronze / silver / gold)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=leitoaberto

# Neon (PostgreSQL que serve a gold para o site e o Power BI)
# formato: postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/leitoaberto?sslmode=require
DATABASE_URL=

# texto aleatorio longo para pseudonimizar campos de CPF (LGPD)
LA_HASH_SALT=troque-por-um-texto-aleatorio-longo

# opcional: primeira competencia carregada (AAAA-MM)
# LA_INICIO=2024-01
