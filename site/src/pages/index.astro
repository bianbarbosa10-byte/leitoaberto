---
import Base from "../layouts/Base.astro";
import Kpi from "../components/Kpi.astro";
import Chart from "../components/Chart.astro";
import { M, ANO_PADRAO, E1_MES, E1_MES_SERIE, MESES_OCULTOS, E2_REG, E3_REG, ULT_CNES, soma, razao } from "../lib/dados";
import { int, pct, dec, mesAno } from "../lib/fmt";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const mesesAno = E1_MES.filter((r) => r.competencia.startsWith(ANO_PADRAO));
const ocupacao = razao(soma(mesesAno, "pacientes_dia"), soma(mesesAno, "leitos_dia"));
const saidas = soma(mesesAno, "saidas");
const reg = E2_REG.filter((r) => String(r.ano) === ANO_PADRAO);
const evasao = 1 - (razao(soma(reg, "na_propria_regiao"), soma(reg, "residentes_internados")) ?? 0);
const cnes = E3_REG.filter((r) => r.competencia === ULT_CNES);
const leitosSus1000 = (1000 * soma(cnes, "leitos_internacao_sus")) / soma(cnes, "populacao");

const serie = {
  kind: "line", unit: "pct", min0: false,
  x: E1_MES_SERIE.map((r) => mesAno(r.competencia)),
  series: [{ name: "Taxa de ocupação (ES)", data: E1_MES_SERIE.map((r) => razao(r.pacientes_dia, r.leitos_dia)) }],
  preliminarDesde: E1_MES_SERIE.findIndex((r) => r.status_dados !== "Consolidado"),
};
---
<Base title="LeitoAberto">
  <section>
    <p class="muted">Portfólio de engenharia e análise de dados em saúde pública · Espírito Santo</p>
    <h1>Leitos, internações e acesso hospitalar no SUS do Espírito Santo</h1>
    <p class="lead">
      O LeitoAberto reúne em um só lugar os dados públicos do DATASUS e do IBGE sobre a rede hospitalar capixaba.
      Os dados são atualizados automaticamente todo mês, passam por um pipeline Bronze → Silver → Gold e alimentam
      três estudos: eficiência operacional, vazio assistencial e capacidade instalada.
    </p>
  </section>

  <section class="grid g4" style="margin-top:1.5rem">
    <Kpi label={`Saídas hospitalares SUS em ${ANO_PADRAO}`} value={int(saidas)} note={`${M.hospitais_com_aih} hospitais com AIH`} />
    <Kpi label={`Taxa de ocupação em ${ANO_PADRAO}`} value={pct(ocupacao)} note="Leitos SUS operacionais, lógica de censo" />
    <Kpi label={`Internações fora da região de residência (${ANO_PADRAO})`} value={pct(evasao)} note="Residentes do ES, AIH principais" />
    <Kpi label={`Leitos SUS de internação por 1.000 hab.`} value={dec(leitosSus1000, 2)} note={`CNES ${mesAno(ULT_CNES)}`} />
  </section>

  <section>
    <h2>Ocupação dos leitos SUS mês a mês</h2>
    <p class="muted">Pacientes-dia ÷ leitos-dia de todos os hospitais com AIH no ES. Os últimos meses ficam marcados como preliminares
      enquanto o SIH ainda recebe AIH atrasadas{MESES_OCULTOS > 0 && `; ${MESES_OCULTOS} ${MESES_OCULTOS === 1 ? "mês ainda muito incompleto foi omitido" : "meses ainda muito incompletos foram omitidos"}`}.</p>
    <div class="card"><Chart spec={serie} label="Taxa de ocupação mensal dos leitos SUS no Espírito Santo" /></div>
  </section>

  <section>
    <h2>Os três estudos</h2>
    <div class="grid g3">
      <a class="card" href={`${base}/estudo-1`}>
        <h3>1 · Eficiência operacional</h3>
        <div class="sub">SIH/SUS + CNES leitos · por hospital e mês</div>
        <p>Taxa de ocupação, média de permanência, giro de leito e mortalidade institucional dos hospitais que atendem o SUS.</p>
      </a>
      <a class="card" href={`${base}/estudo-2`}>
        <h3>2 · Vazio assistencial e fluxo</h3>
        <div class="sub">SIH/SUS + IBGE · por município e região de saúde</div>
        <p>Para onde os pacientes vão para se internar, a distância que percorrem e quais municípios não têm atendimento hospitalar.</p>
      </a>
      <a class="card" href={`${base}/estudo-3`}>
        <h3>3 · Capacidade instalada</h3>
        <div class="sub">CNES leitos, equipamentos e serviços + IBGE</div>
        <p>Leitos e UTI por habitante, participação do SUS, equipamentos de imagem e serviços especializados em cada região.</p>
      </a>
    </div>
  </section>

  <section>
    <h2>Como os dados chegam aqui</h2>
    <div class="flow">
      <div class="step src"><b>Fontes públicas</b><small>FTP do DATASUS (SIH-RD, CNES LT/EQ/SR/ST), API SIDRA e malhas do IBGE, API CNES</small></div>
      <div class="step bronze"><b>Bronze</b><small>Arquivos originais .dbc e cópia fiel em Parquet no Cloudflare R2</small></div>
      <div class="step silver"><b>Silver</b><small>Tipagem, limpeza, códigos traduzidos, regiões de saúde (DuckDB)</small></div>
      <div class="step gold"><b>Gold</b><small>Indicadores dos 3 estudos no Neon (PostgreSQL)</small></div>
      <div class="step out"><b>Site e Power BI</b><small>Este site estático e os painéis do estudo</small></div>
    </div>
    <p style="margin-top:1rem"><a href={`${base}/metodologia`}>Ver a arquitetura, as tabelas e as fórmulas →</a></p>
  </section>
</Base>
